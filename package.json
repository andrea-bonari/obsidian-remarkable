{
  "name": "remarkable-obsidian",
  "version": "1.2.0",
  "description": "A plugin to integrate the reMarkable tablet into an Obsidian workflow, allowing users to insert drawings as nicely styled transparent images",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:postprocessor": "./test/test.sh",
    "build": "./build.sh",
    "build:typescript": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [],
  "author": "spartacus04",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.19.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "tslib": "2.6.2",
    "typescript": "5.2.2"
  },
  "dependencies": {
    "eslint-plugin-editorconfig": "^4.0.3",
    "moment": "^2.31.0"
  }
}